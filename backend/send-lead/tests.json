{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Reject GET",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Silently reject honeypot",
      "method": "POST",
      "path": "/",
      "body": {"name": "Bot", "phone": "+79991234567", "website": "spam.com"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject empty body",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject short phone",
      "method": "POST",
      "path": "/",
      "body": {"name": "Test", "phone": "123"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject spam in message",
      "method": "POST",
      "path": "/",
      "body": {"name": "Test", "phone": "+79991234567", "message": "https://casino.com"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    }
  ]
}
