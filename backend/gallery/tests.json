{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET список фото",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "DELETE без пароля",
      "method": "DELETE",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "POST без пароля",
      "method": "POST",
      "path": "/",
      "body": {"file_base64": "test"},
      "expectedStatus": 401
    },
    {
      "name": "Login с неверным паролем",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "password": "wrong_password_123"},
      "expectedStatus": 401
    }
  ]
}